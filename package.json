{
  "name": "cc-one",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "yarn tauri:dev",
    "check": "yarn web:check && yarn rust:check",
    "test": "yarn web:test && yarn rust:test",
    "web:test": "vitest run",
    "fix": "yarn web:fix && yarn rust:fix",
    "ci": "yarn run check && yarn test && yarn web:build",
    "dist": "yarn tauri:build",
    "web:dev": "vite",
    "web:check": "biome check && tsc --noEmit",
    "web:typecheck": "tsc --noEmit",
    "web:fix": "biome check --write",
    "web:build": "tsc && vite build",
    "rust:check": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "rust:test": "cd src-tauri && cargo test",
    "rust:fix": "cd src-tauri && cargo fmt",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:gen": "cd src-tauri && cross-env VAULTONE_GEN_BINDINGS=1 cargo run"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-is": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-virtuoso": "^4.18.11",
    "recharts": "^3.9.2",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
