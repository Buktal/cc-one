{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC One",
  "mainBinaryName": "CC One",
  "version": "2.0.2",
  "identifier": "app.cc-one",
  "build": {
    "beforeDevCommand": "yarn web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "CC One",
        "width": 920,
        "height": 680,
        "minWidth": 840,
        "minHeight": 600,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 13, "y": 14 }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.config/cc-one/repo/library/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Buktal/cc-one/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwQzk4OTYzMEZDRURBMwpSV1NqN2Z3d2xwZ01DYitXRW0ySVFkWkNzQi9WUi85WTVOVmFla1NBTlpZOFEwZWJ3dVQwbjl3MAo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
